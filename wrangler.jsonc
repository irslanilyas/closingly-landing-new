// closingly.app on Workers Static Assets. The static export in ./out is served
// from the edge; worker/index.ts runs only for /api/* (the beta application).
// Security and cache headers for the files come from out/_headers, generated by
// scripts/build-headers.mjs after `next build`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "closingly-landing",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://fdearocznjaxwplndpyb.supabase.co",
    // Public by design: it can call apply_for_beta and nothing else.
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_5fy8wGF9BOiYGe4K6sjqzQ_fZKf20hA"
  },
  "ratelimits": [{ "name": "APPLY_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "routes": [{ "pattern": "closingly.app", "custom_domain": true }],
  "observability": { "enabled": true },
  "env": {
    // A private preview on workers.dev, never indexed, before the cutover.
    "preview": {
      "name": "closingly-landing-preview",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "SUPABASE_URL": "https://fdearocznjaxwplndpyb.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_5fy8wGF9BOiYGe4K6sjqzQ_fZKf20hA"
      },
      "ratelimits": [{ "name": "APPLY_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }]
    }
  }
}
